{
  "name": "esg-fiems-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend reconstruído da Plataforma ESG-FIEMS (Express + SQLite)",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "node --no-warnings --watch src/server.js",
    "seed": "node --no-warnings src/seed.js",
    "test": "node --no-warnings --test --test-concurrency=1 \"test/**/*.test.js\"",
    "migrate": "node --no-warnings scripts/migrate.js",
    "db:backup": "node --no-warnings scripts/backup.js create",
    "db:verify": "node --no-warnings scripts/backup.js verify",
    "db:dry-run": "node --no-warnings scripts/backup.js dry-run",
    "db:restore": "node --no-warnings scripts/backup.js restore"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  }
}
