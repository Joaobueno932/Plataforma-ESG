# Configuração da API ESG-FIEMS.
# development/test (padrão) usa segredos locais de conveniência;
# production exige os valores abaixo — a API não sobe sem eles (src/config.js).

NODE_ENV=development
PORT=3333

# Obrigatórios em produção (gere valores longos e aleatórios; nunca versione os reais)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Origens autorizadas no CORS, separadas por vírgula. Obrigatório em produção.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Caminhos (padrão: backend/storage e backend/static)
# DB_FILE=
# UPLOADS_DIR=
# STORAGE_DIR=
# BACKUPS_DIR=
# STATIC_DIR=

# Sessão e recuperação de senha
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=30d
RESET_TOKEN_TTL=1h

# Limite de tentativas (login, recuperação de senha, leads)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# Envio de e-mail: 'outbox-file' grava o link em storage/mail-outbox.log.
# Enquanto estiver assim, a recuperação por e-mail NÃO está pronta.
MAIL_TRANSPORT=outbox-file

# Versão do catálogo congelada nos ciclos novos (importação oficial: etapa E3)
# CATALOG_VERSION=legacy-demo
